<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Mac, over the LAN, and whether there is a network to find it on; the camera, for the
         Mac's QR code. Nothing else: multicast comes with the manual path; no location, storage,
         boot or package access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A tablet without a camera pairs by code. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- No backup of any kind (cloud or device-to-device): the pairing holds the device token, and a
         restored tablet pairs again, as an iPad does. -->
    <application
        android:name=".FremkitApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fremkit"
        android:usesCleartextTraffic="false">

        <!-- Safe Browsing sends URL hashes to Google, and WebView metrics go there too: the tablet
             talks to the Mac and to nobody else. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- One task, and no configuration change ever recreates the activity: a rotation or a
             keyboard must not destroy the dashboard's WebView and its socket. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- fremkit://pair?… from another app (a camera app, a browser): always confirmed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="fremkit" />
            </intent-filter>
        </activity>

        <!-- Restarts the app in a fresh process after a pin change (ProcessRestart): it runs in a
             process of its own, so it can end the main one, and shows nothing. -->
        <activity
            android:name=".RestartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
