{ "id": "shortcuts",
  "name": { "fr": "Raccourcis", "en": "Shortcuts" },
  "version": "1.8.0", "preview": "preview.webp",
  "description": { "fr": "Gros boutons tactiles qui ouvrent une application, un lien ou un raccourci",
                   "en": "Big touch buttons that open an application, a link or a shortcut" },
  "category": "productivity",
  "icon": "layout-grid", "sdk": 6, "minSize": [8, 4], "defaultSize": [16, 8],
  "subscriptions": ["dock"], "commands": ["shortcuts"],
  "settingsSchema": {
    "buttons": { "type": "list", "default": [], "max": 24, "summary": ["label", "target"], "grid": "columns",
      "label": { "fr": "Boutons", "en": "Buttons" },
      "itemSchema": {
        "label": { "type": "string", "default": "", "label": { "fr": "Libellé", "en": "Label" } },
        "kind": { "type": "enum", "default": "app",
          "label": { "fr": "Type", "en": "Kind" },
          "options": [{ "value": "app", "label": { "fr": "Application", "en": "Application" } },
                      { "value": "url", "label": { "fr": "Lien", "en": "Link" } },
                      { "value": "shortcut", "label": { "fr": "Raccourci", "en": "Shortcut" } },
                      { "value": "group", "label": { "fr": "Groupe", "en": "Group" } }] },
        "target": { "type": "string", "default": "",
          "suggest": "apps", "suggestWhen": { "kind": "app" }, "showWhen": { "kind": ["app", "url", "shortcut"] },
          "label": { "fr": "Cible (nom d’app, http(s)/mailto, ou nom de raccourci)",
                     "en": "Target (app name, http(s)/mailto link, or shortcut name)" } },
        "profile": { "type": "string", "default": "",
          "suggest": "browserProfiles", "showWhen": { "kind": "url" },
          "label": { "fr": "Ouvrir dans (facultatif) : un profil de Brave, Chrome ou Edge, comme « Brave — Perso »",
                     "en": "Open in (optional): a Brave, Chrome or Edge profile, like “Brave — Personal”" } },
        "icon": { "type": "icon", "default": "",
          "label": { "fr": "Icône (facultatif) : une de vos icônes, un emoji, l’adresse d’une image, ou celle d’un site dont prendre l’icône",
                     "en": "Icon (optional): one of your icons, an emoji, an image address, or a site to take the icon from" } },
        "items": { "type": "list", "default": [], "max": 12, "summary": ["label", "target"], "showWhen": { "kind": "group" },
          "label": { "fr": "Boutons du groupe", "en": "Buttons in the group" },
          "itemSchema": {
            "label": { "type": "string", "default": "", "label": { "fr": "Libellé", "en": "Label" } },
            "kind": { "type": "enum", "default": "app",
              "label": { "fr": "Type", "en": "Kind" },
              "options": [{ "value": "app", "label": { "fr": "Application", "en": "Application" } },
                          { "value": "url", "label": { "fr": "Lien", "en": "Link" } },
                          { "value": "shortcut", "label": { "fr": "Raccourci", "en": "Shortcut" } },
                          { "value": "group", "label": { "fr": "Sous-groupe", "en": "Subgroup" } }] },
            "target": { "type": "string", "default": "",
              "suggest": "apps", "suggestWhen": { "kind": "app" }, "showWhen": { "kind": ["app", "url", "shortcut"] },
              "label": { "fr": "Cible (nom d’app, http(s)/mailto, ou nom de raccourci)",
                         "en": "Target (app name, http(s)/mailto link, or shortcut name)" } },
            "profile": { "type": "string", "default": "",
              "suggest": "browserProfiles", "showWhen": { "kind": "url" },
              "label": { "fr": "Ouvrir dans (facultatif) : un profil de Brave, Chrome ou Edge, comme « Brave — Perso »",
                         "en": "Open in (optional): a Brave, Chrome or Edge profile, like “Brave — Personal”" } },
            "icon": { "type": "icon", "default": "",
              "label": { "fr": "Icône (facultatif)", "en": "Icon (optional)" } },
            "items": { "type": "list", "default": [], "max": 12, "summary": ["label", "target"], "showWhen": { "kind": "group" },
              "label": { "fr": "Boutons du sous-groupe", "en": "Buttons in the subgroup" },
              "itemSchema": {
                "label": { "type": "string", "default": "", "label": { "fr": "Libellé", "en": "Label" } },
                "kind": { "type": "enum", "default": "app",
                  "label": { "fr": "Type", "en": "Kind" },
                  "options": [{ "value": "app", "label": { "fr": "Application", "en": "Application" } },
                              { "value": "url", "label": { "fr": "Lien", "en": "Link" } },
                              { "value": "shortcut", "label": { "fr": "Raccourci", "en": "Shortcut" } }] },
                "target": { "type": "string", "default": "",
                  "suggest": "apps", "suggestWhen": { "kind": "app" },
                  "label": { "fr": "Cible (nom d’app, http(s)/mailto, ou nom de raccourci)",
                             "en": "Target (app name, http(s)/mailto link, or shortcut name)" } },
                "profile": { "type": "string", "default": "",
                  "suggest": "browserProfiles", "showWhen": { "kind": "url" },
                  "label": { "fr": "Ouvrir dans (facultatif) : un profil de Brave, Chrome ou Edge, comme « Brave — Perso »",
                             "en": "Open in (optional): a Brave, Chrome or Edge profile, like “Brave — Personal”" } },
                "icon": { "type": "icon", "default": "",
                  "label": { "fr": "Icône (facultatif)", "en": "Icon (optional)" } }
              } }
          } }
      } },
    "columns": { "type": "number", "default": 4, "label": { "fr": "Colonnes", "en": "Columns" } },
    "profileBadge": { "type": "boolean", "default": true,
      "label": { "fr": "Pastille du profil de navigateur sur les liens", "en": "Browser profile badge on links" } },
    "showIcons": { "type": "boolean", "default": true,
      "label": { "fr": "Icônes des applications et des sites", "en": "Application and site icons" } },
    "background": { "type": "enum", "default": "tinted",
      "label": { "fr": "Fond des boutons", "en": "Button background" },
      "options": [{ "value": "tinted", "label": { "fr": "Teinté", "en": "Tinted" } },
                  { "value": "accent", "label": { "fr": "Couleur d’accent", "en": "Accent colour" } },
                  { "value": "custom", "label": { "fr": "Couleur choisie", "en": "Chosen colour" } },
                  { "value": "none", "label": { "fr": "Aucun", "en": "None" } }] },
    "color": { "type": "color", "default": "#d9b36a",
      "label": { "fr": "Couleur choisie (fond « Couleur choisie »)", "en": "Chosen colour (for the “Chosen colour” background)" } }
  } }
