{ "id": "homey-devices",
  "name": { "fr": "Appareils Homey", "en": "Homey devices" },
  "version": "1.1.0",
  "description": { "fr": "Lampes, prises et capteurs d’un Homey Pro", "en": "Lights, plugs and sensors of a Homey Pro" },
  "category": "home",
  "icon": "layout-grid", "minSize": [8, 4], "defaultSize": [24, 8],
  "compact": { "width": 6 },
  "subscriptions": ["homey:*"], "commands": ["homey:*"],
  "settingsSchema": {
    "connection": { "type": "connection", "connectionType": "homey",
      "label": { "fr": "Connexion", "en": "Connection" } },
    "all": { "type": "boolean", "default": false,
      "label": { "fr": "Afficher tous les appareils", "en": "Show every device" } },
    "devices": { "type": "pick", "connection": "connection", "source": "devices", "default": [],
      "label": { "fr": "Appareils", "en": "Devices" } },
    "zone": { "type": "string", "scope": "tile", "default": "",
      "label": { "fr": "Filtre de zone", "en": "Zone filter" } },
    "max": { "type": "number", "scope": "tile", "default": 12,
      "label": { "fr": "Appareils affichés", "en": "Devices shown" } },
    "showZone": { "type": "boolean", "scope": "tile", "default": true,
      "label": { "fr": "Afficher la zone", "en": "Show the zone" } },
    "compactMode": { "type": "enum", "scope": "compact", "default": "on",
      "label": { "fr": "Barre : afficher", "en": "Bar: show" },
      "options": [
        { "value": "on", "label": { "fr": "Appareils allumés", "en": "Devices that are on" } },
        { "value": "sensor", "label": { "fr": "Première mesure", "en": "First sensor value" } }
      ] }
  } }
