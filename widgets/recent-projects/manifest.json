{ "id": "recent-projects",
  "name": { "fr": "Projets récents", "en": "Recent projects" },
  "version": "0.1.0", "preview": "preview.webp",
  "description": { "fr": "Les dossiers sur lesquels vous avez travaillé récemment, à ouvrir d’un geste",
                   "en": "The folders you worked in lately, one tap away" },
  "category": "dev",
  "icon": "folder-clock", "minSize": [8, 4], "defaultSize": [12, 8],
  "compact": { "width": 8 },
  "subscriptions": ["recent-projects"], "commands": ["recent-projects"],
  "settingsSchema": {
    "source_git": { "type": "boolean", "default": true,
      "label": { "fr": "Source : dépôts git sous les dossiers ci-dessous", "en": "Source: git repositories under the folders below" } },
    "gitRoots": { "type": "list", "default": [], "max": 20,
      "label": { "fr": "Dossiers où chercher des dépôts git (3 niveaux)", "en": "Folders to look for git repositories in (3 levels)" },
      "itemSchema": {
        "path": { "type": "string", "default": "",
          "label": { "fr": "Dossier (~/Dev, /Volumes/Dev…)", "en": "Folder (~/Dev, /Volumes/Dev…)" } }
      } },
    "source_claude": { "type": "boolean", "default": false,
      "label": { "fr": "Source : Claude Code", "en": "Source: Claude Code" } },
    "source_codex": { "type": "boolean", "default": false,
      "label": { "fr": "Source : Codex", "en": "Source: Codex" } },
    "source_vscode": { "type": "boolean", "default": false,
      "label": { "fr": "Source : VS Code (récents)", "en": "Source: VS Code (recent)" } },
    "source_cursor": { "type": "boolean", "default": false,
      "label": { "fr": "Source : Cursor (récents)", "en": "Source: Cursor (recent)" } },
    "source_jetbrains": { "type": "boolean", "default": false,
      "label": { "fr": "Source : IDE JetBrains (récents)", "en": "Source: JetBrains IDEs (recent)" } },
    "source_zoxide": { "type": "boolean", "default": false,
      "label": { "fr": "Source : zoxide", "en": "Source: zoxide" } },
    "source_tmux": { "type": "boolean", "default": false,
      "label": { "fr": "Source : panneaux tmux ouverts", "en": "Source: open tmux panes" } },
    "source_herdr": { "type": "boolean", "default": false,
      "label": { "fr": "Source : panneaux Herdr ouverts", "en": "Source: open Herdr panes" } },
    "defaultApp": { "type": "enum", "default": "finder",
      "label": { "fr": "Ouvrir avec (toucher)", "en": "Open with (tap)" },
      "options": [
        { "value": "finder", "label": { "fr": "Finder", "en": "Finder" } },
        { "value": "terminal", "label": { "fr": "Terminal", "en": "Terminal" } },
        { "value": "iterm", "label": { "fr": "iTerm", "en": "iTerm" } },
        { "value": "ghostty", "label": { "fr": "Ghostty", "en": "Ghostty" } },
        { "value": "vscode", "label": { "fr": "VS Code", "en": "VS Code" } },
        { "value": "cursor", "label": { "fr": "Cursor", "en": "Cursor" } },
        { "value": "zed", "label": { "fr": "Zed", "en": "Zed" } },
        { "value": "xcode", "label": { "fr": "Xcode", "en": "Xcode" } },
        { "value": "jetbrains-idea", "label": { "fr": "IntelliJ IDEA", "en": "IntelliJ IDEA" } },
        { "value": "jetbrains-idea-ce", "label": { "fr": "IntelliJ IDEA CE", "en": "IntelliJ IDEA CE" } },
        { "value": "jetbrains-webstorm", "label": { "fr": "WebStorm", "en": "WebStorm" } },
        { "value": "jetbrains-pycharm", "label": { "fr": "PyCharm", "en": "PyCharm" } },
        { "value": "jetbrains-pycharm-ce", "label": { "fr": "PyCharm CE", "en": "PyCharm CE" } },
        { "value": "jetbrains-phpstorm", "label": { "fr": "PhpStorm", "en": "PhpStorm" } },
        { "value": "jetbrains-goland", "label": { "fr": "GoLand", "en": "GoLand" } },
        { "value": "jetbrains-rider", "label": { "fr": "Rider", "en": "Rider" } },
        { "value": "jetbrains-clion", "label": { "fr": "CLion", "en": "CLion" } },
        { "value": "jetbrains-rustrover", "label": { "fr": "RustRover", "en": "RustRover" } },
        { "value": "jetbrains-rubymine", "label": { "fr": "RubyMine", "en": "RubyMine" } },
        { "value": "jetbrains-datagrip", "label": { "fr": "DataGrip", "en": "DataGrip" } },
        { "value": "jetbrains-android-studio", "label": { "fr": "Android Studio", "en": "Android Studio" } },
        { "value": "herdr", "label": { "fr": "Herdr (panneau existant, sinon nouveau)", "en": "Herdr (existing pane, else a new one)" } },
        { "value": "tmux", "label": { "fr": "tmux (nouvelle fenêtre)", "en": "tmux (new window)" } },
        { "value": "herdr-claude", "label": { "fr": "Herdr + Claude Code (nouveau panneau)", "en": "Herdr + Claude Code (new pane)" } },
        { "value": "herdr-codex", "label": { "fr": "Herdr + Codex (nouveau panneau)", "en": "Herdr + Codex (new pane)" } },
        { "value": "tmux-claude", "label": { "fr": "tmux + Claude Code (nouvelle fenêtre)", "en": "tmux + Claude Code (new window)" } },
        { "value": "tmux-codex", "label": { "fr": "tmux + Codex (nouvelle fenêtre)", "en": "tmux + Codex (new window)" } }
      ] },
    "herdrTerminal": { "type": "enum", "default": "auto",
      "label": { "fr": "Terminal de Herdr (mis au premier plan)", "en": "Herdr’s terminal (brought to the front)" },
      "options": [
        { "value": "auto", "label": { "fr": "Détecter", "en": "Detect" } },
        { "value": "terminal", "label": { "fr": "Terminal", "en": "Terminal" } },
        { "value": "iterm", "label": { "fr": "iTerm", "en": "iTerm" } },
        { "value": "ghostty", "label": { "fr": "Ghostty", "en": "Ghostty" } }
      ] },
    "max": { "type": "number", "default": 8,
      "label": { "fr": "Lignes affichées", "en": "Rows shown" } },
    "compactCount": { "type": "number", "default": 3, "scope": "compact",
      "label": { "fr": "Projets dans la barre", "en": "Projects in the bar" } }
  } }
