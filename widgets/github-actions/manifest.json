{ "id": "github-actions",
  "name": { "fr": "GitHub Actions", "en": "GitHub Actions" },
  "version": "1.0.0",
  "description": { "fr": "Workflows en cours et historique", "en": "Running workflows and history" },
  "category": "dev",
  "icon": "github", "minSize": [16, 6], "defaultSize": [24, 10],
  "subscriptions": ["github:*"],
  "settingsSchema": {
    "connection": { "type": "connection", "connectionType": "github",
      "label": { "fr": "Connexion", "en": "Connection" } },
    "repos": { "type": "pick", "connection": "connection", "source": "repos", "default": [],
      "label": { "fr": "Dépôts", "en": "Repositories" } },
    "max": { "type": "number", "default": 4,
      "label": { "fr": "Workflows en cours affichés", "en": "Running workflows shown" } },
    "history": { "type": "number", "default": 8,
      "label": { "fr": "Runs d’historique", "en": "Runs of history" } }
  } }
