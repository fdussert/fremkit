{ "id": "cleanshot",
  "name": "CleanShot X",
  "version": "1.0.0",
  "description": { "fr": "Gros boutons tactiles pour les captures CleanShot X (activer Réglages → Avancé → API → Allow URL scheme API)",
                   "en": "Big touch buttons for CleanShot X captures (turn on Settings → Advanced → API → Allow URL scheme API)" },
  "category": "mac",
  "icon": "camera", "minSize": [8, 4], "defaultSize": [12, 6],
  "commands": ["cleanshot"],
  "settingsSchema": {
    "showCaptureArea": { "type": "boolean", "default": true,
      "label": { "fr": "Bouton Zone", "en": "Area button" } },
    "showCaptureWindow": { "type": "boolean", "default": true,
      "label": { "fr": "Bouton Fenêtre", "en": "Window button" } },
    "showCaptureFullscreen": { "type": "boolean", "default": true,
      "label": { "fr": "Bouton Plein écran", "en": "Fullscreen button" } },
    "showScrollingCapture": { "type": "boolean", "default": true,
      "label": { "fr": "Bouton Capture défilante", "en": "Scrolling capture button" } },
    "showCaptureText": { "type": "boolean", "default": true,
      "label": { "fr": "Bouton Texte (OCR)", "en": "Text (OCR) button" } },
    "showRecordScreen": { "type": "boolean", "default": true,
      "label": { "fr": "Bouton Enregistrement", "en": "Record button" } },
    "showCapturePreviousArea": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Zone précédente", "en": "Previous area button" } },
    "showAllInOne": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Tout-en-un", "en": "All-in-one button" } },
    "showSelfTimer": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Retardateur", "en": "Self-timer button" } },
    "showOpenHistory": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Historique", "en": "History button" } },
    "showOpenFromClipboard": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Depuis le presse-papiers", "en": "From clipboard button" } },
    "showPin": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Épingler", "en": "Pin button" } },
    "showToggleDesktopIcons": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Icônes du bureau", "en": "Desktop icons button" } },
    "showRestoreRecentlyClosed": { "type": "boolean", "default": false,
      "label": { "fr": "Bouton Restaurer la dernière fermée", "en": "Restore recently closed button" } },
    "columns": { "type": "number", "default": 3, "label": { "fr": "Colonnes", "en": "Columns" } }
  } }
